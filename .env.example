# --- Pinecone (vector DB) ---
# Get a free key at https://app.pinecone.io
PINECONE_API_KEY=PINECONE_API_KEY=pcsk_dummy_key_replace_me
PINECONE_INDEX_NAME=legixo-qa
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Namespace lets you wipe/re-ingest without touching other data in the same index
PINECONE_NAMESPACE=legixo-default

# --- Gemini (LLM, free tier) ---
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=GOOGLE_API_KEY=AIzaSy_dummy_key_replace_me
GEMINI_MODEL=gemini-2.5-flash

# --- Embeddings ---
# Local, free, no API key needed (sentence-transformers, runs on CPU)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Corpus / chunking ---
CORPUS_DIR=gen_ai_takehome_sample_corpus
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval / graph ---
TOP_K=5
MIN_GOOD_CHUNK_SCORE=0.35
MAX_GRAPH_STEPS=6

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
